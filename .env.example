# MongoDB connection string — same database the chrps.app product uses.
# Required for the /signup lead-capture form and /contact message form to work.
MONGODB_URI=

# Database name. Defaults to "chrps" if unset.
MONGODB_DB=chrps

# Zoho CRM — pushes every /signup and /contact submission into Leads as well.
# Optional: if unset, forms still save to Mongo and just skip the Zoho push.
# See README/setup notes for how to generate these from a Zoho "Self Client".
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Change only if your Zoho account is outside the .com data center (e.g. .eu, .in, .com.au).
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
